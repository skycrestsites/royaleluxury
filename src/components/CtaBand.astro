---
interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}

const {
  title = 'Ready to refresh <em>your home</em>?',
  text = 'Explore bedding, kitchen, bath and decor designed to work beautifully together.',
  href = '/shop/',
  label = 'Shop the Collection',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2 set:html={title} />
      <p>{text}</p>
    </div>
    <a class="btn btn--gold" href={href}>{label}</a>
  </div>
</section>

<style>
  .cta-band {
    background: var(--charcoal);
    color: var(--white);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(3.5rem, 7vw, 5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  h2 :global(em) {
    color: var(--champagne);
  }

  p {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.72);
    max-width: 34rem;
  }

  @media (max-width: 720px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn {
      width: 100%;
    }
  }
</style>
