---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { categoryUrl, type Category } from '../data/categories';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<a class="room-tile" href={categoryUrl(category.slug)}>
  <Picture
    src={category.image}
    alt={category.imageAlt}
    widths={[360, 540, 720]}
    sizes="(max-width: 860px) 70vw, 20vw"
    formats={['avif', 'webp']}
    class="room-img"
  />
  <span class="room-overlay">
    <span class="room-name">{category.name}</span>
    <span class="room-cta">Shop now <Icon name="arrowRight" size={14} /></span>
  </span>
</a>

<style>
  .room-tile {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--surface);
    color: var(--white);
  }

  .room-tile :global(picture),
  .room-tile :global(.room-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .room-tile:hover :global(.room-img) {
    transform: scale(1.05);
  }

  .room-overlay {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.35rem;
    padding: 4rem 1.25rem 1.25rem;
    background: linear-gradient(to top, rgba(38, 42, 51, 0.82), rgba(38, 42, 51, 0));
  }

  .room-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .room-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--champagne);
  }
</style>
