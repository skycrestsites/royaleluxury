---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../data/schema';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, crumbs, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-header', { 'has-image': image }]}>
  {
    image && (
      <Picture
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="page-header-img"
      />
    )
  }
  <div class="container page-header-inner">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .page-header-inner {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-header .eyebrow {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
  }

  .page-header:not(:has(.eyebrow)) h1 {
    margin-top: 1.5rem;
  }

  .page-header .lead {
    margin-top: 1rem;
  }

  .has-image {
    min-height: clamp(320px, 42vw, 480px);
    display: flex;
    align-items: flex-end;
    color: var(--white);
    border-bottom: 0;
  }

  .has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(38, 42, 51, 0.85), rgba(38, 42, 51, 0.2));
  }

  .has-image .page-header-inner {
    z-index: 2;
  }

  .has-image :global(picture),
  .has-image :global(.page-header-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .has-image .eyebrow,
  .has-image h1 :global(em) {
    color: var(--champagne);
  }

  .has-image .lead,
  .has-image :global(.breadcrumbs ol),
  .has-image :global(.breadcrumbs [aria-current]) {
    color: rgba(255, 255, 255, 0.85);
  }

  .has-image :global(.breadcrumbs a:hover) {
    color: var(--white);
  }
</style>
