---
import PolicyLayout from '../layouts/PolicyLayout.astro';
import { site } from '../data/site';
---

<PolicyLayout
  title="Privacy Policy"
  heading="Privacy <em>policy</em>"
  description={`How ${site.name} collects, uses and protects your personal information.`}
  path="/privacy-policy/"
  updated="October 2026"
>
  <p>
    {site.name} respects your privacy. This policy explains what information we collect when you visit our website or
    place an order, how we use it and the choices you have.
  </p>

  <h2>Information we collect</h2>
  <ul>
    <li>Contact details you provide, such as your name, email address and shipping address</li>
    <li>Order details, including the products you purchase</li>
    <li>Basic technical information, such as browser type and pages visited, to help us improve the site</li>
  </ul>

  <h2>How we use your information</h2>
  <ul>
    <li>To process and deliver your orders</li>
    <li>To respond to your questions and provide customer support</li>
    <li>To send updates you have chosen to receive, which you can unsubscribe from at any time</li>
    <li>To improve our products, website and services</li>
  </ul>

  <h2>Sharing your information</h2>
  <p>
    We never sell your personal information. We share it only with trusted partners who help us operate our business,
    such as payment processors and shipping carriers, and only as needed to provide our services.
  </p>

  <h2>Your choices</h2>
  <p>
    You can request access to, correction of or deletion of your personal information at any time by emailing{' '}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</PolicyLayout>
