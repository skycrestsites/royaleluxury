rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('role', '') in ['owner', 'admin']
        || (request.auth.token.get('email', '') == 'netspirestudios@gmail.com' && request.auth.token.get('email_verified', false) == true)
      );
    }

    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Product and category images are public so the storefront can display them.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
